PORT=4003
# Same value as WHATSAPP_SERVICE_TOKEN in whatsapp-cloud/.env.
WHATSAPP_SERVICE_TOKEN=change_me
# whatsapp-cloud base URL; group messages are pushed to <url>/groups/ingest.
WHATSAPP_CLOUD_URL=http://localhost:4002
# Linked-device session. Keep it on a persistent disk in production; deleting it
# means scanning the QR again.
WHATSAPP_GROUPS_AUTH_DIR=auth
WHATSAPP_MAX_MEDIA_BYTES=20971520
# Baileys log level: silent | error | warn | info | debug
WHATSAPP_GROUPS_LOG_LEVEL=warn
