model Prospect {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String?
  dialCode      String?
  phoneNumber   String?
  description   String?
  amount        Float?
  address        String?
  status        String   @default("New") // e.g., New, Contacted, Qualified, Lost, Converted
  notes         String?
  nextFollowUp  DateTime @default(now())
  prevFollowup  DateTime?
  assignedAgentId String? @db.ObjectId
  assignedAgent   Agent?  @relation("AgentAssignedProspects", fields: [assignedAgentId], references: [id])
  createdByAgentId String? @db.ObjectId
  createdByAgent   Agent?  @relation("AgentCreatedProspects", fields: [createdByAgentId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  opportunities Opportunity[] @relation("ProspectOpportunities")
  archived      Boolean  @default(false) // If true, this prospect is archived (e.g., converted to opportunity)
  leadSourceId   String?
  leadSource     LeadSource? @relation(fields: [leadSourceId], references: [id])
  comments      Comment[] // Comments/interactions for this prospect

  service           String?

  /// Soft delete: rows are never removed, only stamped. Every read filters on
  /// deletedAt: null. See lib/audit.ts.
  deletedAt       DateTime?
  deletedById     String?   @db.ObjectId
  deletedByType   String? // "USER" | "AGENT"

  /// Who last changed this row. Field-level history lives in DeletionAudit.
  updatedById     String?   @db.ObjectId
  updatedByType   String? // "USER" | "AGENT"

}

model Opportunity {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  phoneNumber   String?
  prevFollowup  DateTime?
  description   String?
  amount        Float?
  nextFollowUp  DateTime?
  status        String   @default("Proposal Issued") // "Proposal Issued", "Closed as Won", "Closed as Loss"
  prospectId    String   @db.ObjectId
  prospect      Prospect @relation("ProspectOpportunities", fields: [prospectId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  comments      Comment[] // Comments/interactions for this opportunity
  quote         String?

  /// Soft delete: rows are never removed, only stamped. Every read filters on
  /// deletedAt: null. See lib/audit.ts.
  deletedAt       DateTime?
  deletedById     String?   @db.ObjectId
  deletedByType   String? // "USER" | "AGENT"

  /// Who last changed this row. Field-level history lives in DeletionAudit.
  updatedById     String?   @db.ObjectId
  updatedByType   String? // "USER" | "AGENT"

}
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

model User {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  username    String    @unique // Used for both login and display
  email       String    @unique
  password    String
  adminType   String    @default("admin") // Either "owner" or "admin"
  status      String    @default("active") // "active" or "inactive"
  photo       String?
  lastLogin   DateTime?
  permissions String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    Comment[] @relation("UserComments")
  diaryEntries DiaryEntry[] @relation("UserDiaryEntries")
  createdQuoteRequests QuoteRequest[] @relation("UserCreatedQuoteRequests")

  // Task Category relations
  createdCategories  TaskCategory[] @relation("UserCreatedCategories")
  approvedCategories TaskCategory[] @relation("CategoryApprovals")
  rejectedCategories TaskCategory[] @relation("CategoryRejections")

  // Retainership relations
  createdRetainerships  Retainership[] @relation("UserCreatedRetainerships")
  approvedRetainerships Retainership[] @relation("RetainershipApprovals")
  rejectedRetainerships Retainership[] @relation("RetainershipRejections")

  // Service Records relation
  serviceRecords ServiceRecord[] @relation("UserServiceRecords")

  // OTP fields for password reset
  resetOtp            String?
  otpExpiry           DateTime?
  isOtpVerified       Boolean   @default(false)
  currentSessionToken String?

  // Audit trail of deletions/updates performed by this admin
  deletionAudits DeletionAudit[] @relation("UserDeletionAudits")

}

/// Append-only record of every soft delete, restore, and update, so a change can
/// always be traced to an actor and a time even after the row is filtered out of
/// normal reads. Written by both the admin and agent apps against one database.
model DeletionAudit {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  entityType String // "Client" | "Prospect" | "Task" | "Retainership" | ...
  entityId   String @db.ObjectId
  entityName String // name/title captured at write time, so it survives later edits

  action String  @default("SOFT_DELETE") // "SOFT_DELETE" | "RESTORE" | "UPDATE"
  reason String?

  /// Names of the fields touched by an UPDATE. Values are deliberately not
  /// stored: the audit answers who and when, not what the old value was.
  changedFields String[] @default([])

  /// Counts of related records left behind, recorded at delete time.
  affectedTaskCount        Int @default(0)
  affectedLegislationCount Int @default(0)

  /// Set when this row was written as a side effect of acting on a parent.
  parentEntityType String?
  parentEntityId   String? @db.ObjectId

  /// The actor is a User (admin app) or an Agent (agent app), never both.
  /// The relation is left optional on both sides so either app can write here.
  performedByType String  @default("USER") // "USER" | "AGENT"
  performedById   String  @db.ObjectId
  performedByUser User?   @relation("UserDeletionAudits", fields: [performedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  performedByAgent Agent? @relation("AgentDeletionAudits", fields: [performedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  performedByEmail    String // denormalized so the audit reads correctly if the actor is later removed
  performedByUsername String

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action, createdAt])
}

