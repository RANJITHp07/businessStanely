model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // File attachment fields
  attachmentName String?
  attachmentUrl  String?
  attachmentSize Int?
  attachmentType String?
  attachments    Json?   // Array of {name, url, size, type} for multiple file attachments

  // Timesheet fields for task comments
  commentDate DateTime? // The date when the comment/work was done (defaults to createdAt if not provided)
  startTime   DateTime? // Start time of the work session
  endTime     DateTime? // End time of the work session

  taskId String? @db.ObjectId
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  prospectId   String? @db.ObjectId
  prospect     Prospect? @relation(fields: [prospectId], references: [id])
  opportunityId String? @db.ObjectId
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  // Author can be either a User or an Agent
  authorId   String @db.ObjectId
  authorType String @default("USER") // "USER" or "AGENT"
  user       User?  @relation("UserComments", fields: [authorId], references: [id])
  agent      Agent? @relation("CommentAuthor", fields: [authorId], references: [id])

  /// Soft delete: rows are never removed, only stamped. Every read filters on
  /// deletedAt: null. See lib/audit.ts.
  deletedAt       DateTime?
  deletedById     String?   @db.ObjectId
  deletedByType   String? // "USER" | "AGENT"

  /// Who last changed this row. Field-level history lives in DeletionAudit.
  updatedById     String?   @db.ObjectId
  updatedByType   String? // "USER" | "AGENT"


  @@index([taskId, createdAt])
}

