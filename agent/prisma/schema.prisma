  createdByAgentId String? @db.ObjectId
  createdByAgent Agent? @relation("AgentCreatedQuoteRequests", fields: [createdByAgentId], references: [id])

  assignedAgentId String @db.ObjectId
  assignedAgent Agent @relation("AgentAssignedQuoteRequests", fields: [assignedAgentId], references: [id])

  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoginHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
