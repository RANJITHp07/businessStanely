# Port the admin panel's WHATSAPP_BACKEND_URL points at.
PORT=4002
# Shared secret with the admin panel (same value as admin WHATSAPP_SERVICE_TOKEN).
WHATSAPP_SERVICE_TOKEN=change_me
WHATSAPP_ALLOWED_ORIGIN=http://localhost:3000

# MongoDB for chats/messages/contacts (collections are prefixed whatsapp_cloud_).
WHATSAPP_MONGODB_URI=mongodb+srv://user:pass@cluster/dbname
# Optional: database name if the URI has none.
WHATSAPP_MONGODB_DB=
# Received/sent media is kept here (Meta deletes media after ~30 days).
WHATSAPP_MEDIA_DIR=/home/ubuntu/whatsapp-cloud-media

# Meta app (developers.facebook.com → your app).
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business → Configurations → WhatsApp Embedded Signup config id.
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Any random string; enter the same value as "Verify token" in the app's webhook settings.
WA_CLOUD_VERIFY_TOKEN=

# Optional manual connection instead of the "Connect" button (system user token).
WA_CLOUD_ACCESS_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_WABA_ID=

WA_CLOUD_GRAPH_VERSION=v23.0
# 10-digit numbers typed in search get this country code.
WA_CLOUD_DEFAULT_COUNTRY_CODE=91
WHATSAPP_MAX_MEDIA_BYTES=20971520
